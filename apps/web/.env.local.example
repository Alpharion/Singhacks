# SurplusFlow web app - copy to .env.local
#
# Only NEXT_PUBLIC_* variables are readable in the browser. Nothing secret
# belongs in this file: the frontend never holds a wallet seed, and never talks
# to a provider or facilitator directly. It only calls the buyer agent.
#
# The root .env.example (owned by Person 4) covers the backend services.

# Where the UI gets its data. Defaults to `live`, so this file is only needed
# to override it.
#   live     - poll the real buyer agent (the demo path)
#   fixtures - replay the frozen contract fixtures in the browser, with the
#              playback clock and no backend (development fallback)
NEXT_PUBLIC_DATA_SOURCE=live

# Person 2's buyer agent, as seen from the Next server. The browser calls
# /api/... on this origin and next.config.ts forwards it here, so the request
# is same-origin and needs no CORS headers from the agent.
BUYER_AGENT_ORIGIN=http://localhost:8001

# Optional. Set this to make the browser call the agent directly instead of
# going through the proxy above. That is a cross-origin request, so the agent
# must send CORS headers or the browser will block it.
# NEXT_PUBLIC_BUYER_AGENT_BASE_URL=http://localhost:8001
