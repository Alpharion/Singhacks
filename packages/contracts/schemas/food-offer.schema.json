{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surplusflow.local/contracts/food-offer.schema.json",
  "title": "FoodOffer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "offerId",
    "sellerId",
    "sellerName",
    "reservationEndpoint",
    "payTo",
    "title",
    "dietaryTags",
    "quantityAvailable",
    "unitPriceDrops",
    "location",
    "preparedAt",
    "expiresAt",
    "pickupWindow",
    "reliabilityScore",
    "status",
    "updatedAt"
  ],
  "properties": {
    "offerId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "sellerId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "sellerName": {"type": "string", "minLength": 1, "maxLength": 100},
    "reservationEndpoint": {"type": "string", "format": "uri"},
    "payTo": {"$ref": "common.schema.json#/$defs/XrplAddress"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 500},
    "dietaryTags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/DietaryTag"}
    },
    "quantityAvailable": {"type": "integer", "minimum": 0, "maximum": 10000},
    "unitPriceDrops": {"$ref": "common.schema.json#/$defs/PositiveDrops"},
    "location": {"$ref": "common.schema.json#/$defs/Location"},
    "preparedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "pickupWindow": {"$ref": "common.schema.json#/$defs/TimeWindow"},
    "reliabilityScore": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["available", "reserved", "sold_out", "expired", "withdrawn"]},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
