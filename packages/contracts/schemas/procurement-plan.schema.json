{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surplusflow.local/contracts/procurement-plan.schema.json",
  "title": "ProcurementPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "goalId",
    "foodAllocations",
    "deliveryQuoteId",
    "totalMeals",
    "foodCostDrops",
    "deliveryCostDrops",
    "totalCostDrops",
    "expectedDeliveryAt",
    "validUntil",
    "riskScore",
    "feasible",
    "rejectionReasons"
  ],
  "properties": {
    "planId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "goalId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "foodAllocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sellerId", "offerId", "quantity", "unitPriceDrops", "lineTotalDrops", "reliabilityScore"],
        "properties": {
          "sellerId": {"$ref": "common.schema.json#/$defs/Identifier"},
          "offerId": {"$ref": "common.schema.json#/$defs/Identifier"},
          "quantity": {"type": "integer", "minimum": 1},
          "unitPriceDrops": {"$ref": "common.schema.json#/$defs/PositiveDrops"},
          "lineTotalDrops": {"$ref": "common.schema.json#/$defs/PositiveDrops"},
          "reliabilityScore": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "deliveryQuoteId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "totalMeals": {"type": "integer", "minimum": 1},
    "foodCostDrops": {"$ref": "common.schema.json#/$defs/PositiveDrops"},
    "deliveryCostDrops": {"$ref": "common.schema.json#/$defs/Drops"},
    "totalCostDrops": {"$ref": "common.schema.json#/$defs/PositiveDrops"},
    "expectedDeliveryAt": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "riskScore": {"type": "number", "minimum": 0, "maximum": 100},
    "feasible": {"type": "boolean"},
    "rejectionReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    }
  }
}
