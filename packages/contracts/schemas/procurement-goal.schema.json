{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surplusflow.local/contracts/procurement-goal.schema.json",
  "title": "ProcurementGoal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goalId",
    "buyerId",
    "mealCount",
    "dietaryTags",
    "destination",
    "deliveryDeadline",
    "maxTotalSpendDrops",
    "minSellerReliability",
    "optimizationPriority",
    "walletPolicyId",
    "createdAt"
  ],
  "properties": {
    "goalId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "buyerId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "mealCount": {"type": "integer", "minimum": 1, "maximum": 10000},
    "dietaryTags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/DietaryTag"}
    },
    "destination": {"$ref": "common.schema.json#/$defs/Location"},
    "deliveryDeadline": {"type": "string", "format": "date-time"},
    "maxTotalSpendDrops": {"$ref": "common.schema.json#/$defs/PositiveDrops"},
    "minSellerReliability": {"type": "number", "minimum": 0, "maximum": 1},
    "optimizationPriority": {
      "type": "string",
      "enum": ["balanced", "lowest_cost", "highest_reliability", "lowest_waste"]
    },
    "walletPolicyId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "approvedSellerIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/Identifier"}
    },
    "approvedCourierIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/Identifier"}
    },
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
