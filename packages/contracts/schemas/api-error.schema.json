{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surplusflow.local/contracts/api-error.schema.json",
  "title": "ApiError",
  "type": "object",
  "additionalProperties": false,
  "required": ["error", "message", "retryable", "requestId"],
  "properties": {
    "error": {
      "type": "string",
      "enum": [
        "invalid_request",
        "not_found",
        "offer_expired",
        "offer_sold_out",
        "quote_expired",
        "provider_unavailable",
        "budget_exceeded",
        "policy_rejected",
        "payment_required",
        "payment_failed",
        "payment_timeout",
        "payment_replayed",
        "invoice_mismatch",
        "network_mismatch",
        "internal_error"
      ]
    },
    "message": {"type": "string", "minLength": 1, "maxLength": 500},
    "retryable": {"type": "boolean"},
    "requestId": {"type": "string", "minLength": 8, "maxLength": 128},
    "details": {"type": "object", "additionalProperties": true}
  }
}
