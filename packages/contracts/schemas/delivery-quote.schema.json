{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surplusflow.local/contracts/delivery-quote.schema.json",
  "title": "DeliveryQuote",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quoteId",
    "providerId",
    "providerName",
    "bookingEndpoint",
    "payTo",
    "pickupSellerIds",
    "destinationZone",
    "capacityMeals",
    "priceDrops",
    "pickupEta",
    "deliveryEta",
    "validUntil",
    "reliabilityScore",
    "status"
  ],
  "properties": {
    "quoteId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "providerId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "providerName": {"type": "string", "minLength": 1, "maxLength": 100},
    "bookingEndpoint": {"type": "string", "format": "uri"},
    "payTo": {"$ref": "common.schema.json#/$defs/XrplAddress"},
    "pickupSellerIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/Identifier"}
    },
    "destinationZone": {"type": "string", "minLength": 1, "maxLength": 80},
    "capacityMeals": {"type": "integer", "minimum": 1, "maximum": 10000},
    "priceDrops": {"$ref": "common.schema.json#/$defs/PositiveDrops"},
    "pickupEta": {"type": "string", "format": "date-time"},
    "deliveryEta": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "reliabilityScore": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["available", "unavailable", "expired"]}
  }
}
