{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surplusflow.local/contracts/payment-requirement.schema.json",
  "title": "PaymentRequirement",
  "description": "Decoded x402 v2 PAYMENT-REQUIRED header for an XRP payment.",
  "type": "object",
  "additionalProperties": true,
  "required": ["x402Version", "accepts"],
  "properties": {
    "x402Version": {"const": 2},
    "accepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["scheme", "network", "asset", "payTo", "amount", "maxTimeoutSeconds", "extra"],
        "properties": {
          "scheme": {"const": "exact"},
          "network": {"$ref": "common.schema.json#/$defs/Network"},
          "asset": {"$ref": "common.schema.json#/$defs/Asset"},
          "payTo": {"$ref": "common.schema.json#/$defs/XrplAddress"},
          "amount": {"$ref": "common.schema.json#/$defs/PositiveDrops"},
          "maxTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
          "extra": {
            "type": "object",
            "additionalProperties": true,
            "required": ["invoiceId", "sourceTag"],
            "properties": {
              "invoiceId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
              "sourceTag": {"type": "integer", "minimum": 0, "maximum": 4294967295},
              "destinationTag": {"type": "integer", "minimum": 0, "maximum": 4294967295}
            }
          }
        }
      }
    }
  }
}
